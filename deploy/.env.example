# Copy to deploy/.env and fill in. deploy/.env is git-ignored; never commit it.
# Compose checks all required values even for services whose profile is off.

# Required
POSTGRES_PASSWORD=
RABBITMQ_PASSWORD=
# Password of the `mlflow` role, created on the first Postgres start.
MLFLOW_DB_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
# Key the API uses to call the LiteLLM proxy. Any string starting with "sk-".
LITELLM_MASTER_KEY=

# Optional until the first real LLM call (ml profile).
OPENROUTER_API_KEY=

# Optional
RAGQA_ENV=dev
RAGQA_LOG_LEVEL=INFO

# Optional: a hosted rerank API instead of the local tei-rerank service (ADR-0023). Do not start
# the `rerank` profile then. With OpenRouter the key lives in the app's environment; pointing
# RAGQA_RERANKER_URL at the LiteLLM proxy (http://litellm:4000/v1) keeps provider keys in the proxy.
# RAGQA_RERANKER_KIND=api
# RAGQA_RERANKER_URL=https://openrouter.ai/api/v1
# RAGQA_RERANKER_MODEL=cohere/rerank-v3.5
# RAGQA_RERANKER_API_KEY=
